# Destination for the sitewide "domain for sale" banner and CTAs.
# Leave unset to route to the on-site /domain page.
# Accepts an absolute http(s) URL, a mailto: link, or a site-relative path.
NEXT_PUBLIC_DOMAIN_SALE_URL=

# Destination for the "Make an Inquiry" button on /domain
# (for example an inquiry form or a mailto: link). If unset, the button falls
# back to NEXT_PUBLIC_DOMAIN_SALE_URL when that is an external URL; otherwise
# no button is rendered. No contact details are hard-coded anywhere.
NEXT_PUBLIC_DOMAIN_INQUIRY_URL=
